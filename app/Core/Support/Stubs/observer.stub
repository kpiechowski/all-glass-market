<?php

declare(strict_types=1);

namespace {{RootNamespace}}\{{ModuleName}}\Infrastructure\Persistence\Observers;

use App\Core\Domain\Events\RecordChanged;
use {{RootNamespace}}\{{ModuleName}}\Infrastructure\Persistence\Models\{{SingularName}}Model;

final class {{SingularName}}Observer
{
    public function saved({{SingularName}}Model $model): void
    {
        $changes = [];

        foreach ($model->getDirty() as $field => $new) {
            $changes[$field] = ['old' => $model->getOriginal($field), 'new' => $new];
        }

        event(new RecordChanged($model::class, $model->id, $changes));
    }
}
